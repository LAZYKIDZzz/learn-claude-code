# AI Agent 配置示例
# 复制此文件为 .env 并填入你的 API 密钥

# ============================================
# AI 提供商选择
# ============================================
# 可选值: anthropic 或 openai
# AI_PROVIDER=anthropic

# ============================================
# Anthropic 配置
# ============================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL_ID=claude-3-5-sonnet-20241022

# 可选：自定义 API 端点（用于代理或自建服务）
# ANTHROPIC_BASE_URL=https://your-proxy.com

# ============================================
# OpenAI 配置
# ============================================
# 如果使用 OpenAI，取消下面的注释并填入密钥
AI_PROVIDER=openai
OPENAI_API_KEY=sk-AL5Ysn6p5Outz2qhkBQbApBXhTcfgrvzxsMPhwEpgbqCnfIs
MODEL_ID=gemini-3-flash-preview

# 可选：自定义 API 端点（用于 Azure OpenAI 或其他兼容服务）
OPENAI_BASE_URL=https://x666.me

# ============================================
# 其他可用的模型
# ============================================
# Anthropic:
#   - claude-3-5-sonnet-20241022 (推荐，最新最强)
#   - claude-3-opus-20240229 (最强但较慢)
#   - claude-3-sonnet-20240229
#   - claude-3-haiku-20240307 (最快但能力较弱)
#
# OpenAI:
#   - gpt-4 (推荐)
#   - gpt-4-turbo
#   - gpt-3.5-turbo (更快但能力较弱)
